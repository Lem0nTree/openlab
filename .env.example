# Copy to .env before starting Compose. Do not commit .env.
POSTGRES_DB=openlab
POSTGRES_USER=openlab
POSTGRES_PASSWORD=replace-with-a-unique-postgres-password

# This hostname is correct inside Docker Compose. Keep it as postgres unless
# deliberately using a remote PostgreSQL server.
DATABASE_URL=postgresql+psycopg://openlab:replace-with-a-unique-postgres-password@postgres:5432/openlab
OPENLAB_DATA_DIR=/var/lib/openlab

# Optional: pin this before first launch so the printed owner setup token is stable.
# deploy/up.sh generates the application secrets below when they are missing.
OPENLAB_SETUP_TOKEN=
OPENLAB_SECRET_KEY=replace-with-a-long-random-session-secret

# Required before saving an external provider API key. deploy/up.sh generates
# this once and preserves it across restarts and image updates.
OPENLAB_ENCRYPTION_KEY=
# Optional stable browser URL used by printed drawer labels, for example
# http://pi3b.local:3000. When empty, the label screen uses its current origin.
OPENLAB_PUBLIC_URL=
# Optional path inside a custom worker image; KiCad is not installed by default.
# Owners can instead save a per-lab override under Settings -> KiCad. This
# deployment value remains the fallback and requires recreating the services.
OPENLAB_KICAD_CLI=

# openlabctl sets a private LAN address (or localhost) for new installations.
# The empty fallback preserves the existing Compose exposure; never forward this
# HTTP port directly to the public internet. Optional Tailscale access is private.
OPENLAB_BIND_ADDRESS=
OPENLAB_PORT=3000
OPENLAB_VERSION=development
# Set by openlabctl with deploy/compose.installer.yml; leave empty for manual Compose.
OPENLAB_INSTALLER_CONTROL_DIR=
## Source builds only: set to 1 to include KiCad in the worker image, then rebuild.
OPENLAB_INSTALL_KICAD=0
