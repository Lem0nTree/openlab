FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

FROM node:24-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NODE_OPTIONS=--max-old-space-size=128
RUN useradd --system --uid 10001 openlab
COPY --from=base --chown=openlab:openlab /app/.next/standalone ./
COPY --from=base --chown=openlab:openlab /app/.next/static ./.next/static
COPY --from=base --chown=openlab:openlab /app/public ./public
USER openlab
EXPOSE 3000
CMD ["node", "server.js"]
